---
// Section II · The collection (ivory)
import TornEdge from './TornEdge.astro';
import Compare from './Compare.astro';
import { LOOKS } from '../data/looks';
---

<section id="collection" class="collection" data-tone="ivory" data-collection aria-labelledby="collection-title">
  <TornEdge />
  <div class="wrap">
    <header class="collection__head">
      <p class="eyebrow">II · The collection</p>
      <h2 id="collection-title" class="display collection__title">Looks, cut for <em>your</em> AI.</h2>
    </header>

    <div class="collection__grid">
      <nav class="look-index" aria-label="Looks" data-look-index>
        {/* With JS: buttons that swap the spread. */}
        <ol class="look-index__list look-index__list--js">
          {
            LOOKS.map((look, i) => (
              <li class="look-index__item">
                <button
                  class="look-index__btn"
                  type="button"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-controls={`look-${look.slug}`}
                  data-look={look.slug}
                >
                  <span class="label look-index__num">{look.numeral}</span>
                  <span class="look-index__name">{look.name}</span>
                  <span class="look-index__dot" aria-hidden="true" />
                </button>
              </li>
            ))
          }
        </ol>
        {/* Without JS every look is on the page, so the index is a plain list of links. */}
        <noscript>
          <ol class="look-index__list">
            {
              LOOKS.map((look) => (
                <li class="look-index__item">
                  <a class="look-index__btn" href={`#look-${look.slug}`}>
                    <span class="label look-index__num">{look.numeral}</span>
                    <span class="look-index__name">{look.name}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </noscript>
      </nav>

      <div class="spreads" data-spreads>
        {
          LOOKS.map((look, i) => (
            <article
              class="spread"
              id={`look-${look.slug}`}
              data-spread={look.slug}
              aria-labelledby={`look-${look.slug}-name`}
            >
              <header class="spread__head" data-spread-head>
                <p class="eyebrow">Look {look.numeral}</p>
                <h3 id={`look-${look.slug}-name`} class="display spread__name">
                  {look.name}
                </h3>
                <p class="lead spread__tagline">{look.tagline}</p>
              </header>

              <div class="spread__compare">
                <Compare look={look} eager={i === 0} />
              </div>
              <p class="spread__note">
                <span>Same prompt. Same AI. Only one wore the look. Drag to compare.</span>
                {look.placeholder && <span class="label spread__flag">Illustrative preview</span>}
              </p>

              <div class="box">
                <h4 class="eyebrow">In the box</h4>
                <dl class="box__grid">
                  {look.contents.map((item) => (
                    <div class="box__item">
                      <dt>{item.title}</dt>
                      <dd>{item.text}</dd>
                    </div>
                  ))}
                </dl>
              </div>

              <div class="spread__buy">
                <p class="spread__price">
                  <span class="visually-hidden">Price: </span>
                  {look.price}
                </p>
                <a class="btn btn--solid" href={look.href} data-checkout={`look-${look.slug}`}>
                  Acquire look {look.numeral}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .collection {
    position: relative;
    z-index: 2;
    background: var(--bg);
    color: var(--fg);
    padding-block: var(--section-pad) calc(var(--section-pad) + var(--torn-h));
  }

  .collection__head {
    margin-bottom: clamp(3rem, 7vw, 6.5rem);
  }
  .collection__title {
    margin-top: 1.25rem;
    font-size: var(--fs-h2);
  }

  .collection__grid {
    display: grid;
    /* minmax(0, …) so the chip row can scroll inside the column instead of widening the page */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 3rem);
  }
  .look-index {
    min-width: 0;
  }

  /* ---------- Look index ---------- */

  :global(html:not(.js)) .look-index__list--js {
    display: none;
  }

  .look-index__btn {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
  }
  .look-index__num {
    color: var(--muted);
    min-width: 1.75rem;
  }
  .look-index__name {
    font-family: var(--font-display);
    font-size: 1.625rem; /* 26px */
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .look-index__dot {
    align-self: center;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--red);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .look-index__btn[aria-pressed='true'] .look-index__name {
    font-style: italic;
  }
  .look-index__btn[aria-pressed='true'] .look-index__dot {
    opacity: 1;
    transform: none;
  }

  /* Phones: a row of chips that scrolls sideways and snaps. */
  @media (max-width: 63.99em) {
    .look-index {
      margin-inline: calc(var(--gutter) * -1);
    }
    .look-index__list {
      display: flex;
      gap: 0.625rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      padding: 0.25rem var(--gutter) 0.75rem;
      scrollbar-width: none;
    }
    .look-index__list::-webkit-scrollbar {
      display: none;
    }
    .look-index__item {
      flex: none;
      scroll-snap-align: start;
    }
    .look-index__btn {
      align-items: center;
      min-height: 3rem;
      padding: 0.35rem 1.1rem 0.45rem;
      border: 1px solid var(--line);
    }
    .look-index__btn[aria-pressed='true'] {
      border-color: var(--fg);
    }
    .look-index__num {
      min-width: 0;
    }
  }

  /* Desktop: a sticky column, like a table of contents. */
  @media (min-width: 64em) {
    .collection__grid {
      grid-template-columns: minmax(15rem, 3fr) minmax(0, 9fr);
      gap: clamp(2.5rem, 5vw, 6rem);
      align-items: start;
    }
    .look-index {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
    .look-index__list {
      border-top: 1px solid var(--line);
    }
    .look-index__item {
      border-bottom: 1px solid var(--line);
    }
    .look-index__btn {
      display: grid;
      grid-template-columns: 2.75rem 1fr auto;
      width: 100%;
      min-height: 3.75rem;
      padding: 0.75rem 0.25rem 0.75rem 0;
    }
  }

  /* ---------- Look spread ---------- */

  .spreads {
    display: grid;
    min-width: 0;
  }
  .spread {
    min-width: 0;
  }
  /* With JS the spreads share one cell so they can cross-fade; hidden ones are removed. */
  :global(html.js) .spread {
    grid-area: 1 / 1;
  }
  .spread[hidden] {
    display: none;
  }
  /* Without JS all six are stacked, separated by a hairline. */
  :global(html:not(.js)) .spread + .spread {
    margin-top: var(--section-pad);
    padding-top: var(--section-pad);
    border-top: 1px solid var(--line);
  }

  .spread__name {
    margin-top: 0.75rem;
    font-size: var(--fs-name);
    font-style: italic;
    /* italic capitals lean left of the box; pull the block back so it aligns with the eyebrow */
    margin-inline-start: -0.035em;
  }
  .spread__tagline {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    max-width: 40ch;
  }

  .spread__compare {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .spread__note {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .spread__flag {
    font-size: 0.75rem;
  }

  .box {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .box__grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
  .box__item dt {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .box__item dd {
    margin-top: 0.35rem;
    max-width: 28ch;
    color: var(--muted);
  }
  @media (min-width: 40em) {
    .box__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  .spread__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .spread__price {
    font-family: var(--font-display);
    font-size: var(--fs-price);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  /* Desktop curtain: the paper overlaps the held hero stage and slides over it (see Hero.astro). */
  @media (min-width: 64em) and (min-height: 38.75em) {
    :global(html.js.motion) .collection {
      margin-top: -100svh;
    }
  }
</style>
