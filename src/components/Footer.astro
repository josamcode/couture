---
import { SITE } from '../data/site';
import { HERO_ARTWORK } from '../data/credits';
import { LOOKS } from '../data/looks';

const demoPreviews = LOOKS.some((l) => l.placeholder);
---

<footer class="site-footer" data-tone="ink">
  {/* The closing signature: the wordmark at full width. Decorative (the header carries the real one). */}
  <div class="site-footer__sign" aria-hidden="true" data-sign>
    <span class="site-footer__sign-inner" data-sign-inner>
      <span class="site-footer__couture" data-sign-word>Couture</span><span class="site-footer__dot" data-sign-dot
      ></span><span class="site-footer__ui" data-sign-ui>UI</span>
    </span>
  </div>
  <div class="wrap site-footer__row">
    <p>© {SITE.year} {SITE.name}</p>
    <p>
      <a href={SITE.instagram.url} rel="noopener">{SITE.instagram.handle}</a>
    </p>
    {
      (HERO_ARTWORK.placeholder || demoPreviews) && (
        <p class="site-footer__credits">
          {HERO_ARTWORK.placeholder && (
            <>
              <a href={HERO_ARTWORK.sourceUrl} rel="noopener">
                {HERO_ARTWORK.creditLine}
              </a>{' '}
            </>
          )}
          {demoPreviews && <span>Look previews are illustrative mock-ups.</span>}
        </p>
      )
    }
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--bg);
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    letter-spacing: 0.04em;
  }
  .site-footer__sign {
    overflow: hidden;
    padding: clamp(2rem, 6vw, 5rem) var(--gutter) clamp(1.25rem, 3vw, 2.5rem);
    border-bottom: 1px solid var(--line);
    color: var(--ivory);
  }
  .site-footer__sign-inner {
    display: flex;
    align-items: baseline;
    justify-content: center;
    white-space: nowrap;
    line-height: 0.86;
    font-size: clamp(4rem, 19.6vw, 24rem);
  }
  .site-footer__couture {
    font-family: var(--font-display);
    letter-spacing: -0.03em;
    padding-block: 0.06em 0.1em;
  }
  .site-footer__dot {
    flex: none;
    width: 0.17em;
    height: 0.17em;
    margin-inline: 0.05em 0.12em;
    border-radius: 50%;
    background: var(--red);
  }
  .site-footer__ui {
    font-family: var(--font-text);
    font-weight: 500;
    font-size: 0.27em;
    letter-spacing: 0.3em;
    margin-inline-end: -0.3em;
  }

  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 2.5rem;
    row-gap: 0.25rem;
    padding-block: 1.25rem 1.75rem;
  }
  .site-footer p {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
  }
  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.3em;
  }
  .site-footer__credits {
    flex-wrap: wrap;
    column-gap: 0.75em;
    margin-inline-start: auto;
    max-width: 62ch;
  }
  @media (max-width: 64em) {
    .site-footer__credits {
      margin-inline-start: 0;
      flex-basis: 100%;
    }
  }
</style>
