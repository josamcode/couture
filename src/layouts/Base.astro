---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TornDefs from '../components/TornDefs.astro';
import { SITE } from '../data/site';
import { motionCss } from '../data/motion';
import { HERO_SIZES, heroSrcset } from '../data/hero';

const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const ogImage = site ? new URL('/og.png', site).href : '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{SITE.title}</title>
    <meta name="description" content={SITE.description} />
    <meta name="theme-color" content="#0B0B0C" />
    <meta name="color-scheme" content="dark" />
    {canonical && <link rel="canonical" href={canonical} />}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={SITE.title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />

    {/* Progressive enhancement: content is only ever hidden for animation after this runs. */}
    <script is:inline>
      (function (d, w) {
        var c = d.documentElement.classList;
        c.add('js');
        if (!w.matchMedia('(prefers-reduced-motion: reduce)').matches) c.add('motion');
        w.setTimeout(function () {
          c.add('reveal-fallback');
        }, 3500);
      })(document, window);
    </script>

    {/* Self-hosted fonts. Preload only what the hero paints with. */}
    <Font
      cssVariable="--font-display"
      preload={[
        { weight: 400, style: 'normal' },
        { weight: 400, style: 'italic' },
      ]}
    />
    <Font cssVariable="--font-text" preload={[{ weight: 400, style: 'normal' }]} />

    {/* The hero painting is the LCP element: fetch it first. */}
    <link
      rel="preload"
      as="image"
      type="image/avif"
      imagesrcset={heroSrcset('painting', 'avif')}
      imagesizes={HERO_SIZES}
      fetchpriority="high"
    />

    <style is:inline set:html={motionCss}></style>
  </head>
  <body data-tone="ink">
    <a class="skip-link" href="#main">Skip to content</a>
    <TornDefs />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
