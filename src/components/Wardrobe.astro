---
// Section III · The wardrobe (ink)
import TornEdge from './TornEdge.astro';
import { WARDROBE } from '../data/site';
---

<section id="wardrobe" class="wardrobe" data-tone="ink" data-wardrobe aria-labelledby="wardrobe-title">
  <TornEdge flip />
  <div class="wrap wardrobe__grid">
    <div class="wardrobe__copy">
      <p class="eyebrow">III · The wardrobe</p>
      <h2 id="wardrobe-title" class="display wardrobe__title" data-wardrobe-title>
        <span class="wardrobe__line">Every AI has skills.</span>
        <span class="wardrobe__line">Few have <em>taste</em><span class="period">.</span></span>
      </h2>
      <p class="lead wardrobe__body">
        The wardrobe is every look in the collection, plus each new one the day it drops.
      </p>
    </div>

    <div class="card" data-wardrobe-card>
      <h3 class="eyebrow">The wardrobe</h3>
      <p class="card__price">
        <span class="visually-hidden">Price: </span>
        {WARDROBE.price}
      </p>
      <ul class="card__list">
        {WARDROBE.includes.map((item) => <li>{item}</li>)}
      </ul>
      <a class="btn btn--solid card__btn" href={WARDROBE.href} data-checkout={WARDROBE.checkout}>
        Acquire the wardrobe
      </a>
    </div>
  </div>
</section>

<style>
  .wardrobe {
    position: relative;
    z-index: 3;
    background: var(--bg);
    color: var(--fg);
    padding-block: calc(var(--section-pad) + 0.5rem) var(--section-pad);
  }

  .wardrobe__grid {
    display: grid;
    gap: clamp(3rem, 8vw, 4.5rem);
  }

  .wardrobe__title {
    margin-top: 1.25rem;
    font-size: var(--fs-h2);
    text-wrap: wrap;
  }
  .wardrobe__line {
    display: block;
  }
  /* SplitText characters (created by JS) */
  .wardrobe__title :global(.wardrobe__ch) {
    will-change: transform, opacity;
  }

  .wardrobe__body {
    margin-top: clamp(1.75rem, 3vw, 2.75rem);
    max-width: 36ch;
  }

  .card {
    padding: clamp(1.5rem, 3vw, 2.75rem);
    border: 1px solid var(--line);
    background: var(--ink-2);
  }
  .card__price {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: var(--fs-price);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .card__list {
    margin-top: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .card__list li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.95rem;
    border-top: 1px solid var(--line);
  }
  /* small red dots: the signature mark */
  .card__list li::before {
    content: '';
    flex: none;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--red);
    transform: translateY(-0.2em);
  }
  .card__btn {
    width: 100%;
    margin-top: 2rem;
  }

  @media (min-width: 64em) {
    .wardrobe__grid {
      grid-template-columns: minmax(0, 7fr) minmax(20rem, 4fr);
      align-items: end;
      gap: clamp(3rem, 6vw, 8rem);
    }
  }
</style>
