---
// Section II · The collection (ivory)
import TornEdge from './TornEdge.astro';
import Compare from './Compare.astro';
import { LOOKS } from '../data/looks';
import Motes from './Motes.astro';
---

<section id="collection" class="collection" data-tone="ivory" data-collection aria-labelledby="collection-title">
  <TornEdge />
  <Motes count={8} seed={41} tone="ink" />
  <div class="wrap" data-collection-wrap>
    <header class="collection__head">
      <p class="eyebrow">II · The collection</p>
      <h2 id="collection-title" class="display collection__title">
        <span class="mask">
          <span data-rise="collection-title" style="--rise-y:108%;--rise-o:1">Looks, cut for <em>your</em> AI.</span>
        </span>
      </h2>
    </header>

    <div class="collection__grid">
      <nav class="look-index" aria-label="Looks" data-look-index>
        {/* With JS: buttons that swap the spread. */}
        <ol class="look-index__list look-index__list--js">
          {
            LOOKS.map((look, i) => (
              <li class="look-index__item" data-rise="index" style={`--i:${i};--rise-y:18px;--rise-step:60ms`}>
                <button
                  class="look-index__btn"
                  type="button"
                  aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-controls={`look-${look.slug}`}
                  data-look={look.slug}
                >
                  <span class="label look-index__num">{look.numeral}</span>
                  <span class="look-index__name">{look.name}</span>
                  <span class="look-index__dot" aria-hidden="true" />
                </button>
              </li>
            ))
          }
        </ol>
        {/* Without working scripts (JavaScript off, or the files failed to load) every look is on
            the page, so the index is a plain list of links instead. */}
          <ol class="look-index__list look-index__list--links">
            {
              LOOKS.map((look) => (
                <li class="look-index__item">
                  <a class="look-index__btn" href={`#look-${look.slug}`}>
                    <span class="label look-index__num">{look.numeral}</span>
                    <span class="look-index__name">{look.name}</span>
                  </a>
                </li>
              ))
            }
          </ol>
      </nav>

      <div class="spreads" data-spreads style={`--looks:${LOOKS.length}`}>
        {
          LOOKS.map((look) => (
            <article
              class="spread"
              id={`look-${look.slug}`}
              data-spread={look.slug}
              aria-labelledby={`look-${look.slug}-name`}
            >
              {/* a giant numeral behind the spread; drawn by CSS, so it is pure decoration */}
              <span class="spread__ghost" aria-hidden="true" data-ghost data-numeral={look.numeral} />
              <header class="spread__head" data-spread-head>
                <p class="eyebrow" data-rise="head" style="--rise-y:34px;--rise-step:90ms">
                  Look {look.numeral}
                </p>
                <h3
                  id={`look-${look.slug}-name`}
                  class="display spread__name"
                  data-rise="head"
                  style="--i:1;--rise-y:34px;--rise-step:90ms"
                >
                  {look.name}
                </h3>
                <p class="lead spread__tagline" data-rise="head" style="--i:2;--rise-y:34px;--rise-step:90ms">
                  {look.tagline}
                </p>
              </header>

              <div class="spread__compare" data-spread-compare>
                <Compare look={look} />
              </div>
              <p class="spread__note" data-rise="note" style="--rise-y:14px">
                <span>Same prompt. Same AI. Only one wore the look. Drag to compare.</span>
                {look.placeholder && <span class="label spread__flag">Illustrative preview</span>}
              </p>

              <div class="box">
                <h4 class="eyebrow" data-rise="box">In the box</h4>
                <dl class="box__grid">
                  {look.contents.map((item, n) => (
                    <div class="box__item" data-rise="box" style={`--i:${n + 1}`}>
                      <dt>{item.title}</dt>
                      <dd>{item.text}</dd>
                    </div>
                  ))}
                </dl>
              </div>

              <div class="spread__buy">
                <p class="spread__price" data-rise="buy" style="--rise-y:18px">
                  <span class="visually-hidden">Price: </span>
                  {look.price}
                </p>
                <a
                  class="btn btn--solid"
                  href={look.href}
                  data-checkout={`look-${look.slug}`}
                  data-rise="buy"
                  style="--i:1;--rise-y:18px"
                >
                  Acquire look {look.numeral}
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* paper grain: a tiny repeating tile, so the ivory reads as a sheet of paper, not a flat colour */
  .collection::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/img/paper-grain.webp') repeat;
    background-size: 128px 128px;
    opacity: 0.55;
    pointer-events: none;
  }
  .collection {
    position: relative;
    z-index: 2;
    background: var(--bg);
    color: var(--fg);
    padding-block: var(--section-pad) calc(var(--section-pad) + var(--torn-h));
  }

  .collection__head {
    margin-bottom: clamp(3rem, 7vw, 6.5rem);
  }
  .collection__title {
    margin-top: 1.25rem;
    font-size: var(--fs-h2);
  }

  .collection__grid {
    display: grid;
    /* minmax(0, …) so the chip row can scroll inside the column instead of widening the page */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 3rem);
  }
  .look-index {
    min-width: 0;
  }

  /* ---------- Look index ---------- */

  /* buttons when the script is driving them, links when it is not */
  :global(html:not(.js)) .look-index__list--js,
  :global(html.reveal-fallback:not(.collection-ready)) .look-index__list--js {
    display: none;
  }
  :global(html.js:not(.reveal-fallback)) .look-index__list--links,
  :global(html.js.collection-ready) .look-index__list--links {
    display: none;
  }

  .look-index__btn {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    min-height: 2.75rem;
    text-align: left;
    text-decoration: none;
    white-space: nowrap;
  }
  .look-index__num {
    color: var(--muted);
    min-width: 1.75rem;
  }
  .look-index__name {
    font-family: var(--font-display);
    font-size: 1.625rem; /* 26px */
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .look-index__dot {
    align-self: center;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--red);
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }
  .look-index__btn[aria-pressed='true'] .look-index__name {
    font-style: italic;
  }
  .look-index__btn[aria-pressed='true'] .look-index__dot {
    opacity: 1;
    transform: none;
  }

  /* Phones: a row of chips that scrolls sideways and snaps. */
  @media (max-width: 63.99em) {
    .look-index {
      margin-inline: calc(var(--gutter) * -1);
    }
    .look-index__list {
      display: flex;
      gap: 0.625rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x proximity;
      scroll-padding-inline: var(--gutter);
      padding: 0.25rem var(--gutter) 0.75rem;
      scrollbar-width: none;
    }
    .look-index__list::-webkit-scrollbar {
      display: none;
    }
    .look-index__item {
      flex: none;
      scroll-snap-align: start;
    }
    .look-index__btn {
      align-items: center;
      min-height: 3rem;
      padding: 0.35rem 1.1rem 0.45rem;
      border: 1px solid var(--line);
    }
    .look-index__btn[aria-pressed='true'] {
      border-color: var(--fg);
    }
    .look-index__num {
      min-width: 0;
    }
  }

  /* Desktop: a sticky column, like a table of contents. */
  @media (min-width: 64em) {
    .collection__grid {
      grid-template-columns: minmax(15rem, 3fr) minmax(0, 9fr);
      gap: clamp(2.5rem, 5vw, 6rem);
      align-items: start;
    }
    .look-index {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
    .look-index__list {
      border-top: 1px solid var(--line);
    }
    .look-index__item {
      border-bottom: 1px solid var(--line);
    }
    .look-index__btn {
      display: grid;
      grid-template-columns: 2.75rem 1fr auto;
      width: 100%;
      min-height: 3.75rem;
      padding: 0.75rem 0.25rem 0.75rem 0;
    }
  }

  /* ---------- Look spread ---------- */

  .spreads {
    display: grid;
    min-width: 0;
  }
  .spread {
    position: relative;
    min-width: 0;
  }
  .spread > :global(*) {
    position: relative;
  }
  .spread > .spread__ghost {
    position: absolute;
    top: -0.16em;
    right: -0.02em;
    font-family: var(--font-display);
    font-size: clamp(13rem, 58vw, 22rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: var(--line);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }
  .spread__ghost::before {
    content: attr(data-numeral);
  }
  @media (min-width: 64em) {
    .spread > .spread__ghost {
      font-size: clamp(22rem, 33vw, 40rem);
    }
  }
  /* the comparison frame tilts up off the table as it scrolls in */
  .spread__compare {
    perspective: 1400px;
  }
  .spread__compare > :global(*) {
    transform-origin: 50% 100%;
    will-change: transform;
  }
  /* With JS the spreads share one cell so they can cross-fade; hidden ones are removed. */
  :global(html.js) .spread {
    grid-area: 1 / 1;
  }
  .spread[hidden] {
    display: none;
  }
  /* Before the script takes over, keep looks II–VI out of the first layout (a much smaller first render).
     `reveal-fallback` is set by a timer in <head>: if the script never arrives, every look is shown. */
  :global(html.js:not(.collection-ready):not(.reveal-fallback)) .spread + .spread {
    display: none;
  }
  :global(html.js.reveal-fallback:not(.collection-ready)) .spread {
    grid-area: auto;
  }
  /* Without JS all six are stacked, separated by a hairline. */
  :global(html:not(.js)) .spread + .spread {
    margin-top: var(--section-pad);
    padding-top: var(--section-pad);
    border-top: 1px solid var(--line);
  }

  .spread__name {
    margin-top: 0.75rem;
    font-size: var(--fs-name);
    font-style: italic;
    /* italic capitals lean left of the box; pull the block back so it aligns with the eyebrow */
    margin-inline-start: -0.035em;
  }
  .spread__tagline {
    margin-top: clamp(1rem, 2vw, 1.5rem);
    max-width: 40ch;
  }

  .spread__compare {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .spread__note {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 2rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .spread__flag {
    font-size: 0.75rem;
  }

  .box {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .box__grid {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }
  .box__item dt {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  .box__item dd {
    margin-top: 0.35rem;
    max-width: 28ch;
    color: var(--muted);
  }
  @media (min-width: 40em) {
    .box__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }

  .spread__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .spread__price {
    font-family: var(--font-display);
    font-size: var(--fs-price);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  /* Desktop: the price and the buy button sit at the top right of the spread, level with the look's name,
     so they stay in view while the looks change. */
  @media (min-width: 64em) {
    .spread > .spread__buy {
      position: absolute;
      top: 0.25rem;
      right: 0;
      flex-direction: column;
      align-items: flex-end;
      gap: 1.1rem;
      margin: 0;
      padding: 0;
      border: 0;
    }
    .spread__head {
      padding-inline-end: 17rem;
    }
    .spread > .spread__ghost {
      top: 26%;
    }
  }

  /* ---------- The fitting room ----------
     With JS + motion, the spread is held on screen (CSS sticky) over a long runway, and scrolling
     walks through the looks one by one while each page gets dressed (see collectionScene in scroll.ts).
     Without JS or with reduced motion none of this applies: the section is a normal page. */
  @media (max-width: 63.99em) and (min-height: 30em) {
    :global(html.js.motion:not(.reveal-fallback)) .collection__grid {
      grid-template-rows: 4.25rem auto;
      row-gap: 0.75rem;
    }
    /* the chips stay reachable for the whole section */
    :global(html.js.motion:not(.reveal-fallback)) .look-index {
      grid-row: 1 / 3;
      align-self: start;
      position: sticky;
      top: 0;
      z-index: 5;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    :global(html.js.motion:not(.reveal-fallback)) .spreads {
      grid-row: 2;
      --seg: 72svh;
      --stick: 4.9rem;
      grid-template-rows: auto calc(var(--looks) * var(--seg));
    }
    :global(html.js.motion:not(.reveal-fallback)) .spread {
      grid-area: 1 / 1 / 3 / 2;
      align-self: start;
      position: sticky;
      top: var(--stick);
      /* on phones the price and the buy button come straight after the frame, so they are on
         screen while the looks change (the note and "In the box" follow below) */
    }
    :global(html.js.motion:not(.reveal-fallback)) .spread:not([hidden]) {
      display: flex;
      flex-direction: column;
    }
    :global(html.js.motion:not(.reveal-fallback)) .spread > .spread__buy {
      order: 1;
      margin-top: 1.1rem;
      padding-top: 0;
      border-top: 0;
      gap: 0.75rem 1.25rem;
    }
    :global(html.js.motion:not(.reveal-fallback)) .spread > .spread__note {
      order: 2;
      margin-top: 1.5rem;
    }
    :global(html.js.motion:not(.reveal-fallback)) .spread > .box {
      order: 3;
    }
    :global(html.js.motion:not(.reveal-fallback)) .spread__compare {
      margin-top: 1.5rem;
      /* the frame gives way on short screens, so the name above it and the price and buy button
         below it are all on screen while the look is held */
      width: min(100%, calc((100svh - var(--stick) - var(--fs-name) * 1.1 - 17rem) * 1.6));
    }
  }
  @media (min-width: 64em) and (min-height: 38.75em) {
    :global(html.js.motion:not(.reveal-fallback)) .spreads {
      --seg: 85svh;
      --stick: calc(var(--header-h) + 1.5rem);
      grid-template-rows: auto calc(var(--looks) * var(--seg));
    }
    :global(html.js.motion:not(.reveal-fallback)) .spread {
      grid-area: 1 / 1 / 3 / 2;
      align-self: start;
      position: sticky;
      top: var(--stick);
    }
    /* the frame takes the height that is left on screen under the look's name */
    :global(html.js.motion:not(.reveal-fallback)) .spread__compare {
      width: min(100%, calc((100svh - var(--header-h) - 1.5rem - var(--fs-name) * 1.08 - 11.5rem) * 1.6));
    }
  }

  /* Fit guard (class set by scroll.ts): the essentials of a look do not fit on this screen
     (very short window, enlarged text), so nothing is held and the section is a normal page. */
  .collection.is-plain .spreads {
    grid-template-rows: auto !important;
  }
  .collection.is-plain .spread {
    position: relative !important;
    top: auto !important;
  }
  @media (max-width: 63.99em) {
    .collection.is-plain .look-index {
      position: static !important;
    }
  }

  /* Desktop curtain: the paper overlaps the held hero stage and slides over it (see Hero.astro). */
  @media (min-width: 64em) and (min-height: 38.75em) {
    :global(html.js.motion:not(.reveal-fallback)) .collection {
      margin-top: -100svh;
    }
  }
  /* Phones: the paper rises over the painting while it is held mid-screen. */
  @media (max-width: 63.99em) and (min-height: 30em) {
    :global(html.js.motion:not(.reveal-fallback)) .collection {
      margin-top: -80svh;
    }
  }
</style>
