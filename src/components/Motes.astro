---
// Dust in candle-light: a few ivory motes drifting slowly through the dark rooms.
// Pure CSS (transform + opacity only, so the compositor does all the work, no JS per frame).
// Decorative. Not rendered into motion at all when the visitor prefers reduced motion.
interface Props {
  count?: number;
  /** Different seeds give different (but repeatable) dust. */
  seed?: number;
  /** Ivory dust for the dark rooms, ink dust for the paper. */
  tone?: 'ivory' | 'ink';
}
const { count = 18, seed = 1, tone = 'ivory' } = Astro.props;

// small seeded generator, so the build output is stable
let a = seed * 2654435761;
const rnd = () => {
  a |= 0;
  a = (a + 0x6d2b79f5) | 0;
  let t = Math.imul(a ^ (a >>> 15), 1 | a);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const r = (min: number, max: number, digits = 1) => (min + rnd() * (max - min)).toFixed(digits);

const motes = Array.from({ length: count }, () => {
  const size = r(1.5, 4.5);
  return [
    `--x:${r(2, 98)}%`,
    `--y:${r(8, 98)}%`,
    `--s:${size}px`,
    `--o:${r(0.18, 0.6, 2)}`,
    `--dx:${r(-46, 46, 0)}px`,
    `--dy:${r(-190, -70, 0)}px`,
    `--t:${r(11, 26)}s`,
    `--d:-${r(0, 26)}s`,
  ].join(';');
});
---

<div class:list={['motes', { 'motes--ink': tone === 'ink' }]} aria-hidden="true" data-motes>
  {motes.map((style) => <i style={style} />)}
</div>

<style>
  .motes {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .motes {
      position: absolute;
      inset: 0;
      display: block;
      overflow: hidden;
      pointer-events: none;
    }
    .motes i {
      position: absolute;
      left: var(--x);
      top: var(--y);
      width: var(--s);
      height: var(--s);
      border-radius: 50%;
      background: var(--ivory);
      opacity: 0;
      animation: mote var(--t) linear var(--d) infinite;
      will-change: transform, opacity;
    }
    /* every third mote is a soft, out-of-focus one */
    .motes i:nth-child(3n) {
      background: radial-gradient(circle, var(--ivory) 0%, transparent 70%);
      width: calc(var(--s) * 3.2);
      height: calc(var(--s) * 3.2);
    }
  }
  .motes--ink {
    opacity: 0.4;
  }
  .motes--ink i {
    background: var(--ink);

  }
  .motes--ink i:nth-child(3n) {
    background: radial-gradient(circle, var(--stone) 0%, transparent 70%);
  }
  @keyframes mote {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) scale(0.6);
    }
    18% {
      opacity: var(--o);
    }
    70% {
      opacity: var(--o);
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--dx), var(--dy), 0) scale(1.15);
    }
  }
</style>
