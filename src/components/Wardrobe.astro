---
// Section III · The wardrobe (ink)
import TornEdge from './TornEdge.astro';
import { WARDROBE } from '../data/site';
import Motes from './Motes.astro';

// The headline is revealed by characters. It is split here, at build time, so the browser never has
// to measure and re-wrap it: each character is a span with its position (--i) for the stagger.
// Assistive tech reads the aria-label on the heading; the spans are hidden from it.
const TITLE = 'Every AI has skills. Few have taste.';
const titleLines: { text: string; em?: boolean; period?: boolean }[][] = [
  [{ text: 'Every' }, { text: 'AI' }, { text: 'has' }, { text: 'skills.' }],
  [{ text: 'Few' }, { text: 'have' }, { text: 'taste', em: true, period: true }],
];
let charIndex = 0;
const nextChar = () => `--i:${charIndex++}`;
---

<section id="wardrobe" class="wardrobe" data-tone="ink" data-wardrobe aria-labelledby="wardrobe-title">
  <TornEdge flip />
  {/* The drawing from Section I returns, faint, behind the closing statement. Decorative. */}
  <div class="wardrobe__sketch" aria-hidden="true">
    <picture data-sketch>
      <source
        type="image/avif"
        srcset="/img/hero/lineart-960.avif 960w, /img/hero/lineart-1920.avif 1920w"
        sizes="(min-width: 64em) 78vw, 150vw"
      />
      <source
        type="image/webp"
        srcset="/img/hero/lineart-960.webp 960w, /img/hero/lineart-1920.webp 1920w"
        sizes="(min-width: 64em) 78vw, 150vw"
      />
      <img src="/img/hero/lineart-960.webp" width="1920" height="1080" alt="" loading="lazy" decoding="async" />
    </picture>
  </div>
  <Motes count={10} seed={23} />
  <div class="wrap wardrobe__grid">
    <div class="wardrobe__copy">
      <p class="eyebrow">III · The wardrobe</p>
      <h2 id="wardrobe-title" class="display wardrobe__title" data-wardrobe-title aria-label={TITLE}>
        {
          titleLines.map((line) => (
            <span class="wardrobe__line" aria-hidden="true">
              {line.map((word, w) => (
                <>
                  {w > 0 && ' '}
                  <span class="wardrobe__w">
                    {word.em ? (
                      <em>
                        {[...word.text].map((ch) => (
                          <span class="wardrobe__ch" data-rise="wardrobe-title" style={nextChar()}>
                            {ch}
                          </span>
                        ))}
                      </em>
                    ) : (
                      [...word.text].map((ch) => (
                        <span class="wardrobe__ch" data-rise="wardrobe-title" style={nextChar()}>
                          {ch}
                        </span>
                      ))
                    )}
                    {word.period && (
                      <span class="wardrobe__ch period" data-rise="wardrobe-title" style={nextChar()}>
                        .
                      </span>
                    )}
                  </span>
                </>
              ))}
            </span>
          ))
        }
      </h2>
      <p class="lead wardrobe__body" data-rise="wardrobe-body">
        The wardrobe is every look in the collection, plus each new one the day it drops.
      </p>
    </div>

    <div class="card" data-wardrobe-card data-rise="card" style="--rise-y:36px">
      <h3 class="eyebrow" data-rise="card" style="--i:2;--rise-y:16px">The wardrobe</h3>
      <p class="card__price" data-rise="card" style="--i:3;--rise-y:16px">
        <span class="visually-hidden">Price: </span>
        {WARDROBE.price}
      </p>
      <ul class="card__list">
        {
          WARDROBE.includes.map((item, n) => (
            <li data-rise="card" style={`--i:${n + 4};--rise-y:16px`}>
              {item}
            </li>
          ))
        }
      </ul>
      <a
        class="btn btn--solid card__btn"
        href={WARDROBE.href}
        data-checkout={WARDROBE.checkout}
        data-rise="card"
        style="--i:7;--rise-y:16px"
      >
        Acquire the wardrobe
      </a>
    </div>
  </div>
</section>

<style>
  .wardrobe {
    position: relative;
    z-index: 3;
    background: var(--bg);
    color: var(--fg);
    padding-block: calc(var(--section-pad) + 0.5rem) var(--section-pad);
  }

  .wardrobe__sketch {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  .wardrobe__sketch picture {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 150vw;
    max-width: none;
    margin: -42vw 0 0 -82vw;
    opacity: 0.22;
    /* fade the drawing out towards its edges so it never reads as a box */
    -webkit-mask-image: radial-gradient(ellipse 58% 62% at 50% 46%, #000 28%, transparent 76%);
    mask-image: radial-gradient(ellipse 58% 62% at 50% 46%, #000 28%, transparent 76%);
    will-change: transform, opacity;
  }
  .wardrobe__sketch img {
    width: 100%;
  }
  @media (min-width: 64em) {
    .wardrobe__sketch picture {
      width: 78vw;
      margin: -22vw 0 0 -52vw;
    }
  }

  .wardrobe__grid {
    position: relative;
    display: grid;
    gap: clamp(3rem, 8vw, 4.5rem);
  }

  .wardrobe__title {
    margin-top: 1.25rem;
    font-size: var(--fs-h2);
    text-wrap: wrap;
  }
  .wardrobe__line {
    display: block;
  }
  /* words never break in the middle; characters are boxes so they can rise one by one */
  .wardrobe__w {
    display: inline-block;
    white-space: nowrap;
  }
  .wardrobe__ch {
    display: inline-block;
    --rise-y: 0.55em;
    --rise-step: 18ms;
  }

  .wardrobe__body {
    margin-top: clamp(1.75rem, 3vw, 2.75rem);
    max-width: 36ch;
  }

  .card {
    padding: clamp(1.5rem, 3vw, 2.75rem);
    border: 1px solid var(--line);
    background: var(--ink-2);
  }
  .card__price {
    margin-top: 1.5rem;
    font-family: var(--font-display);
    font-size: var(--fs-price);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .card__list {
    margin-top: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .card__list li {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.95rem;
    border-top: 1px solid var(--line);
  }
  /* small red dots: the signature mark */
  .card__list li::before {
    content: '';
    flex: none;
    width: 0.3125rem;
    height: 0.3125rem;
    border-radius: 50%;
    background: var(--red);
    transform: translateY(-0.2em);
  }
  .card__btn {
    width: 100%;
    margin-top: 2rem;
  }

  @media (min-width: 64em) {
    .wardrobe__grid {
      grid-template-columns: minmax(0, 7fr) minmax(20rem, 4fr);
      align-items: end;
      gap: clamp(3rem, 6vw, 8rem);
    }
  }
</style>
