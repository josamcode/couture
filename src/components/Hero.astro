---
// Section I · The atelier (ink)
import { HERO_ARTWORK } from '../data/credits';
import { HERO_SIZES, HERO_FALLBACK, heroSrcset } from '../data/hero';
---

<section id="top" class="hero" data-tone="ink" data-hero aria-labelledby="hero-title">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__inner wrap" data-hero-inner>
      <p class="eyebrow hero__eyebrow" data-hero-eyebrow>I · The atelier</p>

      <h1 id="hero-title" class="display hero__title" data-hero-title data-pre-hide>
        {/* Bodoni Moda has no U+2011 glyph (a fallback font would draw it), so the hyphens are plain and the word is kept unbreakable with nowrap. */}
        <span class="hero__line">AI makes <span class="nobr">off-the-rack.</span></span>
        <span class="hero__line">We make <em>couture</em><span class="period">.</span></span>
      </h1>

      <div class="hero__lower">
        <div class="hero__copy" data-hero-copy>
          <p class="lead">
            Design skills, styles and prompts that give your AI a sense of taste. It already has the skills. We hand it
            the eye.
          </p>
          <div class="hero__cta">
            <a class="btn btn--solid" href="#collection">Enter the collection</a>
            <a class="btn btn--outline" href="#wardrobe">The wardrobe</a>
          </div>
        </div>

        <div class="hero__figure-cell">
          <figure class="plate" data-plate>
            <div class="plate__frame">
              <span class="plate__corner plate__corner--tl" aria-hidden="true"></span>
              <span class="plate__corner plate__corner--tr" aria-hidden="true"></span>
              <span class="plate__corner plate__corner--bl" aria-hidden="true"></span>
              <span class="plate__corner plate__corner--br" aria-hidden="true"></span>
              <div class="plate__media">
                <div class="plate__scale" data-plate-scale>
                  {/* The plain image is the LCP element and the permanent fallback for the WebGL effect. */}
                  <picture>
                    <source type="image/avif" srcset={heroSrcset('painting', 'avif')} sizes={HERO_SIZES} />
                    <source type="image/webp" srcset={heroSrcset('painting', 'webp')} sizes={HERO_SIZES} />
                    <img
                      src={HERO_FALLBACK.src}
                      width={HERO_FALLBACK.width}
                      height={HERO_FALLBACK.height}
                      alt={HERO_ARTWORK.alt}
                      fetchpriority="high"
                      loading="eager"
                      decoding="async"
                      data-plate-img
                      data-lineart-sm="/img/hero/lineart-1280.webp"
                      data-lineart-lg="/img/hero/lineart-1920.webp"
                    />
                  </picture>
                </div>
              </div>
            </div>
            <figcaption class="plate__caption">
              <span class="label">Fig. I — The fitting</span>
              <span class="label">Scroll to enter</span>
            </figcaption>
          </figure>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: 1;
    background: var(--bg);
    color: var(--fg);
  }

  .hero__stage {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    /* room for the header above, and for the torn edge of the next section below */
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: calc(var(--torn-h) + 1.5rem);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .hero__eyebrow {
    margin-bottom: clamp(1rem, 2.2vh, 1.75rem);
  }

  .hero__title {
    font-size: var(--fs-h1);
    /* long lines are allowed to wrap on phones; each .hero__line still starts a new line */
    text-wrap: wrap;
  }
  .hero__line {
    display: block;
  }

  /* SplitText line masks (created by JS): leave room for descenders and the italic overhang. */
  .hero__title :global(.hero__ln-mask) {
    padding-bottom: 0.14em;
    margin-bottom: -0.14em;
    padding-inline-end: 0.06em;
    margin-inline-end: -0.06em;
  }
  .hero__title :global(.hero__ln) {
    will-change: transform;
  }

  .hero__lower {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 6vw, 3rem);
    margin-top: clamp(1.5rem, 5vw, 2.25rem);
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 4vw, 2.25rem);
  }

  /* ---------- The plate (framed painting) ---------- */

  .plate {
    width: 100%;
  }
  .plate__frame {
    position: relative;
  }
  .plate__media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink-2);
  }
  .plate__scale {
    position: absolute;
    inset: 0;
  }
  /* Starting pose for the settle-in (1.06 → 1). Only when JS + motion are on. */
  :global(html.js.motion) .plate__scale {
    transform: scale(1.06);
  }
  .plate__scale picture,
  .plate__scale img {
    width: 100%;
    height: 100%;
  }
  .plate__scale img {
    object-fit: cover;
  }
  /* The WebGL canvas (added by JS) sits exactly over the image and fades in once it has a frame. */
  .plate__scale :global(.plate__canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--dur-base) var(--ease-out);
  }
  .plate__scale :global(.plate__canvas.is-live) {
    opacity: 1;
  }

  /* Thin corner marks, like registration marks on a plate. */
  .plate__corner {
    position: absolute;
    width: 0.875rem;
    height: 0.875rem;
    border: 0 solid var(--muted);
    pointer-events: none;
  }
  .plate__corner--tl {
    top: -0.5rem;
    left: -0.5rem;
    border-top-width: 1px;
    border-left-width: 1px;
  }
  .plate__corner--tr {
    top: -0.5rem;
    right: -0.5rem;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  .plate__corner--bl {
    bottom: -0.5rem;
    left: -0.5rem;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
  .plate__corner--br {
    bottom: -0.5rem;
    right: -0.5rem;
    border-bottom-width: 1px;
    border-right-width: 1px;
  }

  .plate__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.125rem;
    color: var(--muted);
  }

  /* ---------- Desktop: one composed screen ---------- */

  @media (min-width: 64em) and (min-height: 38.75em) {
    .hero__stage {
      height: 100svh;
      padding-top: calc(var(--header-h) + clamp(0.5rem, 2.4vh, 2rem));
      padding-bottom: clamp(1.25rem, 3vh, 2.25rem);
    }
    .hero__inner {
      min-height: 0;
    }
    .hero__lower {
      flex: 1;
      min-height: 0;
      display: grid;
      grid-template-columns: minmax(17rem, 4.7fr) minmax(0, 7.3fr);
      align-items: end;
      gap: clamp(2rem, 4vw, 5rem);
      margin-top: clamp(1.25rem, 3.4vh, 2.75rem);
    }
    .hero__copy {
      /* sit on the same line as the bottom of the painting, above the caption row */
      padding-bottom: 2.4rem;
    }
    /* The painting takes whatever height is left, and never more than its column. */
    .hero__figure-cell {
      container-type: size;
      align-self: stretch;
      display: flex;
      align-items: flex-end;
      justify-content: flex-end;
      min-height: 0;
    }
    .plate {
      width: min(100cqw, calc((100cqh - 2.6rem) * 16 / 9));
    }

    /* The curtain: the stage holds still while the painting dissolves, then the paper slides over it.
       Pure CSS sticky (no JS pinning). Only when JS + motion are on; otherwise the section is one screen tall. */
    :global(html.js.motion) .hero {
      height: 260svh;
    }
    :global(html.js.motion) .hero__stage {
      position: sticky;
      top: 0;
    }
  }
</style>
